# 静态站缓存头（2026-10-01）
# ===============================================================
# 本文件会被 Vite 原样复制到 dist/_headers，Netlify / Cloudflare Pages
# **自动读取**并在回包上挂 Cache-Control —— 这两个是「把 dist 目录传上去」
# 最常见的两种托管，开箱即用。
#
# ⚠️ 换别的托管（Nginx / Apache / 对象存储）本文件**不生效**，请照抄下面
#    注释里的等价写法。
#
# 规则只有三类，且**互不重叠**（A 的路径永远不会命中 B 的路径）—— 这样就不必
# 依赖各家「多条命中时谁赢」的差异：
#   A. 名字固定、内容会变的（外壳）        → no-cache：每次回源校验，必拿新版
#   B. 名字带内容哈希的产物（assets）      → immutable：一年不查，改名即失效
#   C. 行情包（data）                      → no-cache：交给 SW 的 SWR 去省流量
#
# Nginx 等价写法（放进 server{} 里）：
#   location = /index.html          { add_header Cache-Control "no-cache" always; }
#   location = /sw.js               { add_header Cache-Control "no-cache" always; }
#   location = /manifest.webmanifest{ add_header Cache-Control "no-cache" always; }
#   location   /assets/             { add_header Cache-Control "public, max-age=31536000, immutable" always; }
#   location   /data/               { add_header Cache-Control "no-cache" always; }
#
# ⚠️ 硬约束（见 ROADMAP §四十九）：`/data/*.bin` 的文件名**不能加哈希** ——
#    `data/index.json` 里写死了文件名，运行时按名读。所以它只能靠 A/C 这
#    两条「老实回源」的规则，不能靠改名绕缓存。

# ── 外壳：名字固定，必须每次校验 ──
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# ── 产物：名字带 [hash]，内容与名字一一对应，可以永久缓存 ──
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ── 行情包：SW 自己走 stale-while-revalidate，这一层只负责「别挡道」 ──
/data/*
  Cache-Control: no-cache

# ── 图标：名字固定、内容几乎不变，一周足够 ──
/icon-192.png
  Cache-Control: public, max-age=604800

/icon-512.png
  Cache-Control: public, max-age=604800